{
  "expo": {
    "name": "Need for Food",
    "slug": "need-for-food-mobile",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.needforfood.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#E67E22",
        "foregroundImage": "./assets/images/logo-adaptive-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Need for Food a besoin d'accéder à vos photos pour illustrer vos recettes."
        }
      ],
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
