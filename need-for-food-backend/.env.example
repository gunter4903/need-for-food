DB_HOST=localhost
DB_PORT=5432
DB_NAME=need_for_food
DB_USERNAME=need_for_food
DB_PASSWORD=need_for_food

PGADMIN_EMAIL=admin@needforfood.com
PGADMIN_PASSWORD=admin

MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=need_for_food
MONGO_USERNAME=need_for_food
MONGO_PASSWORD=need_for_food

# SMTP pour l'e-mail de vérification de compte à l'inscription. Par défaut (localhost:1025,
# rien de démarré), l'envoi échoue silencieusement : aucun e-mail réel n'est envoyé, mais le
# code de vérification reste visible dans les logs du backend. Renseigner un vrai serveur SMTP
# (ex: Brevo, Gmail avec mot de passe d'application, etc.) pour tester la réception réelle.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@needforfood.dev
