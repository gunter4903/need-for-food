# Copier en .env sur le VPS (jamais commité) et remplacer toutes les valeurs ci-dessous.
# Générer des mots de passe/secrets forts, par ex. : openssl rand -base64 32

DB_NAME=need_for_food
DB_USERNAME=need_for_food
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

PGADMIN_EMAIL=admin@needforfood.fr
PGADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

MONGO_DATABASE=need_for_food
MONGO_USERNAME=need_for_food
MONGO_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# 256 bits minimum — générer avec : openssl rand -base64 32
JWT_SECRET=CHANGE_ME_RANDOM_256_BIT_SECRET

# SMTP Brevo (mêmes identifiants que ceux déjà utilisés en développement)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=no-reply@needforfood.fr

# URL publique de l'API (utilisée pour construire les URLs des photos de recette) — sans /api à la fin.
APP_BASE_URL=https://api.needforfood.fr
